<mvc:View
    controllerName="smartprocurex.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid">

    <Page showHeader="false" class="smartProcureXDashboard">

        <content>
            <!-- Top Header -->
            <VBox class="sapUiMediumMargin">
                <Title text="SmartProcureX" titleStyle="H1" class="dashboardTitle" />
                <Text text="Enterprise Procurement &amp; Asset Management Platform" class="dashboardSubtitle" />
            </VBox>

            <!-- Actions Toolbar -->
            <OverflowToolbar class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom">
                <ToolbarSpacer />
                <Button
                    text="View Suppliers"
                    icon="sap-icon://supplier"
                    press=".onViewSuppliers"
                    type="Default" />
                <Button
                    text="Create Supplier"
                    icon="sap-icon://add-contact"
                    press=".onCreateSupplier"
                    type="Default" />
                <Button
                    text="View Purchase Orders"
                    icon="sap-icon://list"
                    press=".onViewPurchaseOrders"
                    type="Default" />
                <Button
                    text="Create Request"
                    icon="sap-icon://add"
                    press=".onCreateRequest"
                    type="Emphasized" />
            </OverflowToolbar>

            <!-- SECTION A: Purchase Request Overview -->
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <Title text="Purchase Request Overview" class="sectionTitle" />
                <ToolbarSeparator class="sapUiSmallMarginBottom" style="width: 100%" />

                <!-- PR KPI Cards Grid -->
                <grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(200px, 1fr))" gridGap="1rem">
                    
                    <!-- Total PR -->
                    <VBox class="kpiCard kpiThemeBlue">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Total PR" class="kpiTitle" />
                                <Text text="Total Purchase Requests" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/totalPR}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://request" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Draft PR -->
                    <VBox class="kpiCard kpiThemeOrange">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Draft" class="kpiTitle" />
                                <Text text="Waiting for Submission" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/draft}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://edit" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Submitted PR -->
                    <VBox class="kpiCard kpiThemePurple">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Submitted" class="kpiTitle" />
                                <Text text="Pending Approval" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/submitted}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://outbox" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Approved PR -->
                    <VBox class="kpiCard kpiThemeGreen">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Approved" class="kpiTitle" />
                                <Text text="Successfully Approved" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/approved}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://approvals" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Rejected PR -->
                    <VBox class="kpiCard kpiThemeRed">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Rejected" class="kpiTitle" />
                                <Text text="Rejected Requests" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/rejected}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://decline" class="kpiIcon" />
                        </HBox>
                    </VBox>
                </grid:CSSGrid>

                <!-- Purchase Requests Table -->
                <Table
                    class="sapUiSmallMarginTop"
                    items="{ path:'/PurchaseRequests' }"
                    sticky="ColumnHeaders"
                    alternateRowColors="true"
                    backgroundDesign="Solid">
                    
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Recent Requests" level="H2" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="Request Number"/>
                        </Column>
                        <Column>
                            <Text text="Priority"/>
                        </Column>
                        <Column hAlign="End">
                            <Text text="Amount"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="Status"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onRequestPress">
                            <cells>
                                <Text text="{requestNumber}" class="sapMObjectNumberText" />
                                <Text text="{priority}"/>
                                <ObjectNumber
                                    number="{totalAmount}"
                                    unit="INR" />
                                <Text
                                    text="{status}"
                                    class="{
                                        path: 'status',
                                        formatter: '.getBadgeClass'
                                    }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

            <!-- SECTION B: Purchase Order Overview -->
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <Title text="Purchase Order Overview" class="sectionTitle" />
                <ToolbarSeparator class="sapUiSmallMarginBottom" style="width: 100%" />

                <!-- PO KPI Cards Grid -->
                <grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(200px, 1fr))" gridGap="1rem">
                    
                    <!-- Total PO -->
                    <VBox class="kpiCard kpiThemeIndigo">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Total PO" class="kpiTitle" />
                                <Text text="Total Purchase Orders" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/totalPO}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://sales-order" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Created PO -->
                    <VBox class="kpiCard kpiThemeCyan">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Created" class="kpiTitle" />
                                <Text text="Draft Orders" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/poCreated}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://create" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Sent PO -->
                    <VBox class="kpiCard kpiThemeTeal">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Sent" class="kpiTitle" />
                                <Text text="Sent to Supplier" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/poSent}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://paper-plane" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Closed PO -->
                    <VBox class="kpiCard kpiThemeDarkGreen">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Closed" class="kpiTitle" />
                                <Text text="Completed Orders" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/poClosed}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://accept" class="kpiIcon" />
                        </HBox>
                    </VBox>
                </grid:CSSGrid>
            </VBox>

            <!-- SECTION C: Supplier Overview -->
            <VBox class="sapUiMediumMarginBeginEnd sapUiMediumMarginBottom">
                <Title text="Supplier Overview" class="sectionTitle" />
                <ToolbarSeparator class="sapUiSmallMarginBottom" style="width: 100%" />

                <!-- Supplier KPI Cards Grid -->
                <grid:CSSGrid gridTemplateColumns="repeat(auto-fit, minmax(200px, 1fr))" gridGap="1rem">
                    
                    <!-- Total Suppliers -->
                    <VBox class="kpiCard kpiThemeBlue">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Total Suppliers" class="kpiTitle" />
                                <Text text="Registered Suppliers" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/totalSuppliers}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://supplier" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Active Suppliers -->
                    <VBox class="kpiCard kpiThemeGreen">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Active" class="kpiTitle" />
                                <Text text="Active Suppliers" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/activeSuppliers}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://sys-enter-2" class="kpiIcon" />
                        </HBox>
                    </VBox>

                    <!-- Inactive Suppliers -->
                    <VBox class="kpiCard kpiThemeRed">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="kpiContentArea">
                                <Text text="Inactive" class="kpiTitle" />
                                <Text text="Inactive Suppliers" class="kpiSubtitle" />
                                <Text text="{dashboardModel>/inactiveSuppliers}" class="kpiValue" />
                            </VBox>
                            <core:Icon src="sap-icon://error" class="kpiIcon" />
                        </HBox>
                    </VBox>

                </grid:CSSGrid>
            </VBox>

        </content>
    </Page>
</mvc:View>