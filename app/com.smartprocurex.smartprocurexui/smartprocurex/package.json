{
    "name": "smartprocurex",
    "version": "0.0.1",
    "description": "smartprocurex description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
        "@sap/ux-ui5-tooling": "1",
        "@ui5/cli": "^4.0.33",
        "@ui5/linter": "latest",
        "@wdio/cli": "^9.30.0",
        "@wdio/local-runner": "^9.30.0",
        "@wdio/mocha-framework": "^9.30.0",
        "@wdio/spec-reporter": "^9.29.1",
        "eslint": "^10",
        "ui5-middleware-simpleproxy": "^3.8.0",
        "wdio-ui5-service": "^3.0.10"
    },
    "scripts": {
        "start": "fiori run --open index.html",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest ../dist/smartprocurex",
        "lint": "eslint ./",
        "start-variants-management": "fiori run --open \"/preview.html?sap-ui-xx-viewCache=false&fiori-tools-rta-mode=true&sap-ui-rta-skip-flex-validation=true#smartprocurex-display\"",
        "ui5lint": "ui5lint",
        "qunit": "fiori run --open test/unitTests.qunit.html",
        "opa5": "fiori run --open test/opaTests.qunit.html",
        "wdi5": "wdio run ./webapp/test/e2e/\\wdio.conf.js"
    }
}
