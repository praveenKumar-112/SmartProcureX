{
    "name": "com.smartprocurex.smartprocurexui",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "start": "DEBUG=approuter:* node node_modules/@sap/approuter/approuter.js",
        "build": "mbt build --mtar com.smartprocurex.smartprocurexui.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/com.smartprocurex.smartprocurexui.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:smartprocurex": "npm start --workspace smartprocurex"
    },
    "dependencies": {
        "mbt": "^1",
        "@sap/approuter": "^16.0.0"
    },
    "workspaces": [
        "smartprocurex"
    ],
    "devDependencies": {
        "ui5-middleware-simpleproxy": "^3.8.0"
    }
}
